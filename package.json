{
  "name": "integration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "commit": "node scripts/commit.mjs",
    "pr": "node scripts/abrir-pr.mjs",
    "proteger-branch": "node scripts/proteger-branch-principal.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky"
